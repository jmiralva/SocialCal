{
  "name": "socialcal",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev --port 8788",
    "build": "vite build",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "vitest run",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply socialcal --local",
    "db:migrate:remote": "wrangler d1 migrations apply socialcal --remote",
    "db:migrate:preview": "wrangler d1 migrations apply socialcal-preview --remote --env preview",
    "deploy": "npm run build && wrangler pages deploy"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  }
}
